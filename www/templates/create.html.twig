{% extends "base.html.twig" %}

{% block title %}Ajouter un manuscrit{% endblock %}
{% block content %}
<h1>Ajouter un manuscrit</h1>

{% if erreur %}<p>{{ erreur }}</p>{% endif %}

<form method="post" action="create.php">
    <p><label>Référence <input name="cote"></label></p>
    <p><label>Titre <input name="titre" required></label></p>
    <p><label>Auteur <input name="auteur"></label></p>
    <p><label>Langue <input name="langue"></label></p>
    <p><label>Siècle <input name="siecle"></label></p>
    <p><label>édition <input name="edition"></label></p>
    <button type="submit">Ajouter</button>
</form>

<p><a href="/">Retour à la liste</a></p>
{% endblock %}