{% extends "base.html.twig" %}

{% block title %}Détail du manuscrit{% endblock %}
{% block content %}
<h1>Detail du manuscrit</h1>
<table>
    {% for champ, valeur in document %}
    <tr>
        <th>{{ champ }}</th>
        <td>{{ valeur is iterable ? valeur|json_encode : valeur }}</td>
    </tr>
    {% endfor %}
</table>
<p><a href="app.php">Retour a la liste</a></p>
{% endblock %}