{% extends "base.html.twig" %}

{% block title %}Modification d'un manuscrit{% endblock %}
{% block content %}
<h1>Modifier le manuscrit</h1>
<form action="/update.php" method="post">
    <input type="hidden" name="id" value="{{ entity._id }}">

    <p><label>Référence : <input type="text" name="cote" value="{{ entity.cote ?? '' }}"></label></p>
    <p><label>Titre : <input type="text" name="titre" value="{{ entity.titre ?? '' }}" size="100"></label></p>
    <p><label>Auteur : <input type="text" name="auteur" value="{{ entity.auteur ?? '' }}" size="50"></label></p>
    <p><label>Langue : <input type="text" name="langue" value="{{ entity.langue ?? '' }}"></label></p>
    <p><label>Siècle : <input type="text" name="siecle" value="{{ entity.siecle ?? '' }}"></label></p>
    <p><label>Édition : <input type="text" name="edition" value="{{ entity.edition ?? '' }}" size="50"></label></p>

    <button type="submit">Enregistrer</button>
</form>
<p><a href="/">Retour à la liste</a></p>
{% endblock %}